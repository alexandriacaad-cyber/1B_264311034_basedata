-- ---------------- PENGISIAN REKAP AKSES GAGAL BULANAN ----------------
-- Boleh dijalankan ulang kapan saja: rekap lama dihapus lalu dihitung ulang.
DELETE FROM rekap_akses_gagal_bulanan;

INSERT INTO rekap_akses_gagal_bulanan (id_pintu, tahun, bulan, jumlah_gagal, jumlah_total_akses)
SELECT t.id_pintu, t.tahun, t.bulan,
       SUM(CASE WHEN t.hasil = 'gagal' THEN 1 ELSE 0 END),
       COUNT(*)
FROM (
  SELECT id_pintu, YEAR(waktu_akses) AS tahun, MONTH(waktu_akses) AS bulan, hasil
  FROM log_akses
) t
GROUP BY t.id_pintu, t.tahun, t.bulan;

UPDATE rekap_akses_gagal_bulanan r
SET r.alasan_terbanyak = (
  SELECT l.alasan_gagal
  FROM log_akses l
  WHERE l.id_pintu = r.id_pintu
    AND YEAR(l.waktu_akses)  = r.tahun
    AND MONTH(l.waktu_akses) = r.bulan
    AND l.hasil = 'gagal'
  GROUP BY l.alasan_gagal
  ORDER BY COUNT(*) DESC
  LIMIT 1
);

-- ---------------- QUERY VERIFIKASI ----------------
SELECT * FROM rekap_akses_gagal_bulanan;

SELECT pg.nama, rg.nama_ruangan, l.waktu_akses, l.metode, l.hasil
FROM log_akses l
JOIN pintu pt           ON pt.id_pintu = l.id_pintu
JOIN ruangan rg         ON rg.id_ruangan = pt.id_ruangan
LEFT JOIN sidik_jari sj ON sj.id_jari = l.id_jari
LEFT JOIN pengguna pg   ON pg.id_pengguna = sj.id_pengguna
ORDER BY l.waktu_akses;

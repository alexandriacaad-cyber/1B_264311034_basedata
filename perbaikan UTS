-- TAHAP 2: BENTUK NORMAL KEDUA (2NF)
-- Hilangkan ketergantungan parsial terhadap PK komposit:
--   id_pengguna -> nama, no_hp, id_role, nama_role, level_akses
--   id_pintu    -> id_ruangan, nama_ruangan, lantai, versi_firmware
--   (id_pengguna, jenis_jari) -> template_hash
--   (id_pengguna, id_pintu)   -> jam_mulai, jam_selesai

SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS log_akses_2nf;
DROP TABLE IF EXISTS hak_akses_2nf;
DROP TABLE IF EXISTS sidik_jari_2nf;
DROP TABLE IF EXISTS pintu_2nf;
DROP TABLE IF EXISTS pengguna_2nf;
SET FOREIGN_KEY_CHECKS = 1;

CREATE TABLE pengguna_2nf (
  id_pengguna VARCHAR(10)  NOT NULL,
  nama        VARCHAR(100) NOT NULL,
  no_hp       VARCHAR(15)  NULL,
  id_role     VARCHAR(5)   NOT NULL,
  nama_role   VARCHAR(30)  NOT NULL,
  level_akses INT          NOT NULL,
  PRIMARY KEY (id_pengguna)
) ENGINE=InnoDB;

CREATE TABLE pintu_2nf (
  id_pintu       VARCHAR(10) NOT NULL,
  id_ruangan     VARCHAR(10) NOT NULL,
  nama_ruangan   VARCHAR(50) NOT NULL,
  lantai         INT         NOT NULL,
  versi_firmware VARCHAR(20) NULL,
  PRIMARY KEY (id_pintu)
) ENGINE=InnoDB;

CREATE TABLE sidik_jari_2nf (
  id_pengguna   VARCHAR(10)  NOT NULL,
  jenis_jari    VARCHAR(20)  NOT NULL,
  template_hash VARCHAR(255) NOT NULL,
  PRIMARY KEY (id_pengguna, jenis_jari),
  FOREIGN KEY (id_pengguna) REFERENCES pengguna_2nf (id_pengguna)
) ENGINE=InnoDB;

CREATE TABLE hak_akses_2nf (
  id_pengguna VARCHAR(10) NOT NULL,
  id_pintu    VARCHAR(10) NOT NULL,
  jam_mulai   TIME        NOT NULL,
  jam_selesai TIME        NOT NULL,
  PRIMARY KEY (id_pengguna, id_pintu),
  FOREIGN KEY (id_pengguna) REFERENCES pengguna_2nf (id_pengguna),
  FOREIGN KEY (id_pintu)    REFERENCES pintu_2nf (id_pintu)
) ENGINE=InnoDB;

CREATE TABLE log_akses_2nf (
  id_pengguna VARCHAR(10) NOT NULL,
  jenis_jari  VARCHAR(20) NOT NULL,
  id_pintu    VARCHAR(10) NOT NULL,
  waktu_akses DATETIME    NOT NULL,
  hasil       VARCHAR(10) NOT NULL,
  PRIMARY KEY (id_pengguna, jenis_jari, id_pintu, waktu_akses),
  FOREIGN KEY (id_pengguna, jenis_jari) REFERENCES sidik_jari_2nf (id_pengguna, jenis_jari),
  FOREIGN KEY (id_pintu) REFERENCES pintu_2nf (id_pintu)
) ENGINE=InnoDB;


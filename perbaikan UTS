-- TAHAP 3: BENTUK NORMAL KETIGA (3NF) + PENAMBAHAN PROSES BISNIS
-- Hilangkan ketergantungan transitif:
--   id_role    -> nama_role, level_akses  => tabel role
--   id_ruangan -> nama_ruangan, lantai    => tabel ruangan
-- Proses bisnis tambahan: akses tamu (tamu, permintaan_akses_tamu),
-- monitoring keamanan (peringatan_keamanan), pemantauan perangkat
-- (data_kondisi_perangkat), dan rekap bulanan (rekap_akses_gagal_bulanan).
-- Total 12 tabel.

SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS rekap_akses_gagal_bulanan;
DROP TABLE IF EXISTS data_kondisi_perangkat;
DROP TABLE IF EXISTS peringatan_keamanan;
DROP TABLE IF EXISTS log_akses;
DROP TABLE IF EXISTS permintaan_akses_tamu;
DROP TABLE IF EXISTS tamu;
DROP TABLE IF EXISTS hak_akses;
DROP TABLE IF EXISTS sidik_jari;
DROP TABLE IF EXISTS pintu;
DROP TABLE IF EXISTS ruangan;
DROP TABLE IF EXISTS pengguna;
DROP TABLE IF EXISTS `role`;
SET FOREIGN_KEY_CHECKS = 1;

CREATE TABLE `role` (
  id_role     INT          NOT NULL AUTO_INCREMENT,
  nama_role   VARCHAR(30)  NOT NULL,
  level_akses INT          NOT NULL,
  PRIMARY KEY (id_role),
  UNIQUE KEY uq_role_nama (nama_role)
) ENGINE=InnoDB;

CREATE TABLE ruangan (
  id_ruangan   INT          NOT NULL AUTO_INCREMENT,
  nama_ruangan VARCHAR(50)  NOT NULL,
  lantai       INT          NOT NULL,
  gedung       VARCHAR(50)  NOT NULL,
  PRIMARY KEY (id_ruangan)
) ENGINE=InnoDB;

CREATE TABLE pengguna (
  id_pengguna  INT          NOT NULL AUTO_INCREMENT,
  nama         VARCHAR(100) NOT NULL,
  nim_nip      VARCHAR(20)  NOT NULL,
  no_hp        VARCHAR(15)  NULL,
  status_aktif TINYINT(1)   NOT NULL DEFAULT 1,
  id_role      INT          NOT NULL,
  PRIMARY KEY (id_pengguna),
  UNIQUE KEY uq_pengguna_nim (nim_nip),
  FOREIGN KEY (id_role) REFERENCES `role` (id_role)
) ENGINE=InnoDB;

CREATE TABLE pintu (
  id_pintu         INT         NOT NULL AUTO_INCREMENT,
  id_ruangan       INT         NOT NULL,
  kode_perangkat   VARCHAR(30) NOT NULL,
  versi_firmware   VARCHAR(20) NULL,
  status_perangkat VARCHAR(15) NOT NULL DEFAULT 'online',
  PRIMARY KEY (id_pintu),
  UNIQUE KEY uq_pintu_kode (kode_perangkat),
  FOREIGN KEY (id_ruangan) REFERENCES ruangan (id_ruangan)
) ENGINE=InnoDB;

CREATE TABLE tamu (
  id_tamu      INT          NOT NULL AUTO_INCREMENT,
  nama         VARCHAR(100) NOT NULL,
  no_identitas VARCHAR(30)  NOT NULL,
  no_hp        VARCHAR(15)  NULL,
  instansi     VARCHAR(100) NULL,
  PRIMARY KEY (id_tamu)
) ENGINE=InnoDB;

CREATE TABLE sidik_jari (
  id_jari       INT          NOT NULL AUTO_INCREMENT,
  id_pengguna   INT          NOT NULL,
  jenis_jari    VARCHAR(20)  NOT NULL,
  template_hash VARCHAR(255) NOT NULL,
  tgl_daftar    DATE         NOT NULL,
  PRIMARY KEY (id_jari),
  UNIQUE KEY uq_jari_pengguna (id_pengguna, jenis_jari),
  FOREIGN KEY (id_pengguna) REFERENCES pengguna (id_pengguna)
) ENGINE=InnoDB;

CREATE TABLE hak_akses (
  id_hak_akses   INT  NOT NULL AUTO_INCREMENT,
  id_pengguna    INT  NOT NULL,
  id_pintu       INT  NOT NULL,
  jam_mulai      TIME NOT NULL,
  jam_selesai    TIME NOT NULL,
  berlaku_dari   DATE NOT NULL,
  berlaku_sampai DATE NOT NULL,
  PRIMARY KEY (id_hak_akses),
  FOREIGN KEY (id_pengguna) REFERENCES pengguna (id_pengguna),
  FOREIGN KEY (id_pintu)    REFERENCES pintu (id_pintu)
) ENGINE=InnoDB;

CREATE TABLE permintaan_akses_tamu (
  id_permintaan   INT          NOT NULL AUTO_INCREMENT,
  id_tamu         INT          NOT NULL,
  id_host         INT          NOT NULL,
  id_pintu        INT          NOT NULL,
  id_penyetuju    INT          NULL,
  waktu_mulai     DATETIME     NOT NULL,
  waktu_selesai   DATETIME     NOT NULL,
  kode_akses_hash VARCHAR(255) NULL,
  status          VARCHAR(15)  NOT NULL DEFAULT 'menunggu',
  PRIMARY KEY (id_permintaan),
  FOREIGN KEY (id_tamu)      REFERENCES tamu (id_tamu),
  FOREIGN KEY (id_host)      REFERENCES pengguna (id_pengguna),
  FOREIGN KEY (id_pintu)     REFERENCES pintu (id_pintu),
  FOREIGN KEY (id_penyetuju) REFERENCES pengguna (id_pengguna)
) ENGINE=InnoDB;

CREATE TABLE log_akses (
  id_log        INT          NOT NULL AUTO_INCREMENT,
  id_pintu      INT          NOT NULL,
  id_jari       INT          NULL,
  id_permintaan INT          NULL,
  waktu_akses   DATETIME     NOT NULL,
  metode        VARCHAR(15)  NOT NULL,
  hasil         VARCHAR(10)  NOT NULL,
  alasan_gagal  VARCHAR(100) NULL,
  PRIMARY KEY (id_log),
  FOREIGN KEY (id_pintu)      REFERENCES pintu (id_pintu),
  FOREIGN KEY (id_jari)       REFERENCES sidik_jari (id_jari),
  FOREIGN KEY (id_permintaan) REFERENCES permintaan_akses_tamu (id_permintaan)
) ENGINE=InnoDB;

CREATE TABLE peringatan_keamanan (
  id_peringatan INT         NOT NULL AUTO_INCREMENT,
  id_pintu      INT         NOT NULL,
  id_log        INT         NOT NULL,
  id_penangani  INT         NULL,
  jenis         VARCHAR(30) NOT NULL,
  waktu         DATETIME    NOT NULL,
  status        VARCHAR(15) NOT NULL DEFAULT 'baru',
  PRIMARY KEY (id_peringatan),
  FOREIGN KEY (id_pintu)     REFERENCES pintu (id_pintu),
  FOREIGN KEY (id_log)       REFERENCES log_akses (id_log),
  FOREIGN KEY (id_penangani) REFERENCES pengguna (id_pengguna)
) ENGINE=InnoDB;

CREATE TABLE data_kondisi_perangkat (
  id_kondisi      INT          NOT NULL AUTO_INCREMENT,
  id_pintu        INT          NOT NULL,
  waktu_cek       DATETIME     NOT NULL,
  tingkat_baterai TINYINT      NOT NULL,
  kekuatan_sinyal SMALLINT     NULL,
  status_koneksi  VARCHAR(15)  NOT NULL,
  status_sensor   VARCHAR(15)  NOT NULL,
  suhu_perangkat  DECIMAL(4,1) NULL,
  catatan         VARCHAR(100) NULL,
  PRIMARY KEY (id_kondisi),
  UNIQUE KEY uq_kondisi_pintu_waktu (id_pintu, waktu_cek),
  FOREIGN KEY (id_pintu) REFERENCES pintu (id_pintu)
) ENGINE=InnoDB;

CREATE TABLE rekap_akses_gagal_bulanan (
  id_rekap           INT          NOT NULL AUTO_INCREMENT,
  id_pintu           INT          NOT NULL,
  tahun              SMALLINT     NOT NULL,
  bulan              TINYINT      NOT NULL,
  jumlah_gagal       INT          NOT NULL DEFAULT 0,
  jumlah_total_akses INT          NOT NULL DEFAULT 0,
  alasan_terbanyak   VARCHAR(100) NULL,
  dibuat_pada        DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id_rekap),
  UNIQUE KEY uq_rekap_pintu_periode (id_pintu, tahun, bulan),
  FOREIGN KEY (id_pintu) REFERENCES pintu (id_pintu)
) ENGINE=InnoDB;

